// explore — standalone tab: yazi-current + yazi-preview (locked) + lazygit.
// Launch:  zellij action new-tab --layout ~/.config/zellij/layouts/explore.kdl
// yazi-current publishes cd events; if an `edit` tab exists, yazi-cd-sync
// forwards them to kak and lazygit-follow.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar";
        }
        children;
        pane size=1 borderless=true {
            plugin location="zjstatus";
        }
    }

    tab name="explore" focus=true {
        pane split_direction="vertical" {
            pane size="30%" split_direction="horizontal" {
                pane size="50%" name="yazi-current" {
                    command "bash";
                    args "/home/mknelo/.config/zellij/scripts/yazi-current.sh";
                }
                pane size="50%" name="yazi-preview" {
                    command "bash";
                    args "/home/mknelo/.config/zellij/scripts/yazi-preview.sh";
                }
            }
            pane size="70%" name="lazygit" {
                command "bash";
                args "/home/mknelo/.config/zellij/scripts/lazygit-follow.sh";
            }
        }
    }
}
