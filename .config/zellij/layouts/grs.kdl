layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar";
        }
        children;
        pane size=2 borderless=true {
            plugin location="status-bar";
        }
    }

    tab name="explore" focus=true {
        pane split_direction="vertical" {
            pane size="30%" split_direction="horizontal" {
                pane size="50%" name="yazi-current" {
                    command "/home/mknelo/dotfiles/.config/zellij/scripts/yazi-current.sh";
                }
                pane size="50%" name="yazi-preview" {
                    command "/home/mknelo/dotfiles/.config/zellij/scripts/yazi-preview.sh";
                }
            }
            pane size="70%" name="lazygit" {
                command "/home/mknelo/dotfiles/.config/zellij/scripts/lazygit-follow.sh";
            }
        }
    }

    tab name="edit" {
        pane split_direction="vertical" {
            pane size="70%" name="nvim" {
                command "/home/mknelo/dotfiles/.config/zellij/scripts/nvim-listen.sh";
            }
            pane size="30%" name="yazi-neotree" {
                command "/home/mknelo/dotfiles/.config/zellij/scripts/yazi-neotree.sh";
            }
        }
    }
}
